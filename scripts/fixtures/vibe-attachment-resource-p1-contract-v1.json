{
  "schema": "vibe_attachment_p1_contract.v1",
  "phase": "P1",
  "upload": {
    "method": "POST",
    "path": "/vibe/sessions/{session_id}/attachments",
    "multipart_file_field": "file",
    "idempotency_header": "Idempotency-Key",
    "success_statuses": [201, 200],
    "response_fields": ["ok", "resource", "state", "expires_at", "idempotent_replay"],
    "expires_at_type": "string|null"
  },
  "cleanup": {
    "method": "DELETE",
    "path": "/vibe/sessions/{session_id}/attachments/{resource_id}",
    "pending_only": true,
    "idempotent": true
  },
  "p1_resource_ref": {
    "implemented": true,
    "schema": "attachment_resource_ref.v1",
    "required_fields": [
      "schema",
      "resource_id",
      "filename",
      "mime",
      "size",
      "chars",
      "content_sha256",
      "download_url"
    ],
    "turn_payload_must_not_include": ["content", "text"]
  },
  "turn": {
    "upload_all_before_send": true,
    "preserve_selection_order": true,
    "rollback_uploaded_pending_on_batch_failure": true,
    "retain_selection_until_user_event_bound": true,
    "rollback_pending_when_user_event_not_bound": true
  },
  "legacy_inline_download": {
    "supported": true,
    "fields": ["content", "text"]
  }
}
